{
	"name": "dhaaga",
	"version": "0.19.3",
	"description": "Dhaaga - An indie SNS app that blends sleek design 💅, useful features ✨ and fun ways to discover and connect 🎉",
	"author": "Debashish Patra <mailto:suvam0451@icloud.com>",
	"homepage": "https://suvam.io/dhaaga",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"scripts": {
		"dev:app": "npm run dev --workspace=@dhaaga/mobile",
		"build:db": "npm run build --workspace=@dhaaga/db",
		"build:bridge": "npm run build --workspace=@dhaaga/bridge",
		"build:core": "npm run build --workspace=@dhaaga/core",
		"build:orm": "npm run build --workspace=@dhaaga/orm",
		"build:react": "npm run build --workspace=@dhaaga/react",
		"build:all": "npm run build:bridge && npm run build:orm && npm run build:db && npm run build:core && npm run build:react ",
		"build-deps": "npm run build:all",
		"check-env": "node scripts/check-env.js"
	},
	"workspaces": [
		"packages/*",
		"apps/mobile"
	],
	"prettier": {
		"bracketSpacing": true,
		"printWidth": 80,
		"semi": true,
		"singleQuote": true,
		"tabWidth": 2,
		"useTabs": true
	},
	"devDependencies": {
		"prettier": "^3.8.4"
	},
	"overrides": {
		"react": "19.2.3",
		"@types/react": "19.2.14"
	},
	"type": "module"
}
